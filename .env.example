# Root env for `docker compose` (copy to `.env` next to docker-compose.yml).
# API also uses apps/api/.env when running `pnpm dev` outside Compose.

# --- Required ---
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# --- Auth URLs (set to your public HTTPS origins in production) ---
AUTH_BASE_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# Browser-facing API URL (web container → user browser).
# Read at BUILD time, like every NEXT_PUBLIC_* — Next freezes it into the
# browser bundle. Change it and rebuild (`docker compose up -d --build web`),
# or the client keeps calling whatever was inlined last and every request fails
# while the page itself still loads.
NEXT_PUBLIC_SAGE_API_URL=http://localhost:3001
# Server-side API URL (web container → api service on the Docker network)
SAGE_API_URL=http://api:3001

# --- Signup policy ---
# True for the first account, then false and recreate the api container.
ALLOW_SIGNUP=true

# --- Database (Compose defaults; change password for any real deployment) ---
POSTGRES_USER=sage
POSTGRES_PASSWORD=sage
POSTGRES_DB=sage
# Used by the api service inside Compose (host is service name `db`)
DATABASE_URL=postgres://sage:sage@db:5432/sage
# Host port Postgres is published on, for psql and dumps from the host. Change
# it if 5432 is already taken; nothing inside Compose is affected, since the
# api reaches the database as `db:5432` on the Compose network either way.
POSTGRES_PORT=5432

# --- Optional market data ---
MARKET_DATA_PROVIDER=yahoo
# EODHD_API_TOKEN=
# Twelve Data: set MARKET_DATA_PROVIDER=twelvedata and a key. What a key covers
# depends on its plan — the free plan is US prices only, and everything outside
# the plan falls back to Yahoo. See docs/MARKET-DATA.md.
# TWELVEDATA_API_KEY=
# Your plan's per-minute credits (free 8, Grow 55, Pro/Venture 610).
# TWELVEDATA_CREDITS_PER_MINUTE=8
# Fills in sector, country and the real company name, which Diversification
# needs — without it that page reads "Unknown" for every holding. Defaults to
# `yahoo`, which needs no key and is the same host prices already come from.
# Set to `none` to stop profile lookups.
# ENRICHMENT_PROVIDER=yahoo

# --- Company logos and news thumbnails: per-user switches, not env vars ---
# Both are off by default and turned on per user in Settings → Privacy. They
# are the only things in Sage that can tell a third party what you hold: a logo
# is a request to img.logo.dev naming a company, a thumbnail is a request to the
# publisher's image host for a story about one, both from your browser at your
# address. With both switches off, nothing does.
#
# Optional default logo.dev publishable key (pk_…) for users who turn logos on
# without entering a key of their own. Setting it does NOT turn logos on for
# anyone. Read at BUILD time, not run time: change it and rebuild
# (`docker compose up -d --build web`), or it has no effect.
# NEXT_PUBLIC_LOGO_DEV_TOKEN=
