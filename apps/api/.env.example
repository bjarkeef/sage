# Copy to .env (gitignored). All API config lives here.

# --- Database ---
DATABASE_URL=postgres://sage:sage@localhost:5432/sage

# --- Server ---
PORT=3001

# --- Auth ---
BETTER_AUTH_SECRET=generate-a-random-64-char-hex-string
# Public origin of this API (cookies / better-auth base URL).
AUTH_BASE_URL=http://localhost:3001
# Comma-separated web origins allowed for credentialed CORS.
WEB_ORIGIN=http://localhost:3000
# true = open registration (hosted multi-tenant). Self-host: create your
# account once, then set ALLOW_SIGNUP=false so strangers cannot register.
ALLOW_SIGNUP=true

# --- Market Data Provider ---
# "yahoo" (default, no key needed) or "eodhd".
# Non-yahoo primaries automatically fall back to Yahoo for symbols they
# can't serve (coverage gaps, exhausted free-tier quota).
MARKET_DATA_PROVIDER=yahoo
EODHD_API_TOKEN=your-eodhd-api-token

# --- FX rates ---
# None. FX comes from the ECB euro reference rates: free, keyless and
# unrationed. Rates are stored locally in fx_rate_daily and refreshed on start.

# --- Enrichment (optional) ---
# "yahoo" or "none" (default). Fills missing fundamentals
# (P/E, market cap, beta) on asset profiles. Results are cached in the
# asset_profile table (24h TTL) so the enricher is called at most once/symbol/day.
ENRICHMENT_PROVIDER=none
